<ui:FluentWindow x:Class="CS2Box.EulaWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="免责声明"
                 Width="720" Height="620"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="使用前请阅读" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,12">
            <TextBlock Text="免责声明" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="请完整阅读以下内容。继续使用表示你已理解并同意全部条款。" />
        </StackPanel>

        <Border Grid.Row="2" Margin="28,0,28,0" CornerRadius="8" Padding="18,14"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <TextBlock x:Name="TermsText" TextWrapping="Wrap" FontSize="13" LineHeight="23"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="28,16,28,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="AgreeBox" Grid.Column="0" VerticalAlignment="Center"
                      Checked="Agree_Changed" Unchecked="Agree_Changed"
                      Content="我已阅读并同意上述全部内容" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="DeclineBtn" Content="不同意，退出" MinWidth="120"
                           Margin="0,0,10,0" Click="Decline_Click" />
                <ui:Button x:Name="AcceptBtn" Content="同意并继续" Appearance="Primary"
                           MinWidth="120" IsEnabled="False" Click="Accept_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
