<Page x:Class="CS2Box.Pages.CrosshairPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="准星">
    <Page.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="准星" Style="{StaticResource PageTitle}" />
        <TextBlock Text="可以粘贴分享码导入，调好后写入 autoexec.cfg 或生成分享码。" Style="{StaticResource PageSub}" />

        <!-- 分享码 -->
        <ui:Card Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="Code" PlaceholderText="CSGO-xxxxx-xxxxx-xxxxx-xxxxx-xxxxx" FontFamily="Consolas" />
                <ui:Button Grid.Column="1" Content="导入" Margin="8,0,0,0" Click="Import_Click" />
                <ui:Button Grid.Column="2" Content="生成分享码" Margin="8,0,0,0" Click="Export_Click" />
            </Grid>
        </ui:Card>

        <ui:Card Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border CornerRadius="6" Height="240" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#6D7F8F" Offset="0" />
                                <GradientStop Color="#A49A83" Offset="0.55" />
                                <GradientStop Color="#5C564A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas x:Name="Preview" Width="240" Height="240" />
                    </Border>
                    <TextBlock Text="预览为近似效果，实际以游戏内为准" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Text="样式" VerticalAlignment="Center" />
                        <ComboBox x:Name="StyleBox" Grid.Column="1" SelectionChanged="Any_Changed">
                            <ComboBoxItem Content="0 默认" />
                            <ComboBoxItem Content="1 默认静态" />
                            <ComboBoxItem Content="2 经典" />
                            <ComboBoxItem Content="3 经典动态" />
                            <ComboBoxItem Content="4 经典静态" />
                            <ComboBoxItem Content="5 传统" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock Text="长度" VerticalAlignment="Center" />
                        <Slider x:Name="SSize" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SSize, StringFormat=0.#}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock Text="粗细" VerticalAlignment="Center" />
                        <Slider x:Name="SThick" Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SThick, StringFormat=0.#}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock Text="间隙" VerticalAlignment="Center" />
                        <Slider x:Name="SGap" Grid.Column="1" Minimum="-10" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SGap, StringFormat=0.#}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock Text="描边" VerticalAlignment="Center" />
                        <ui:ToggleSwitch x:Name="Outline" Grid.Column="1" Margin="0,0,12,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                        <Slider x:Name="SOutline" Grid.Column="2" Minimum="0" Maximum="3" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                        <TextBlock Grid.Column="3" Text="{Binding Value, ElementName=SOutline, StringFormat=0.#}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBlock Text="透明度" VerticalAlignment="Center" />
                        <ui:ToggleSwitch x:Name="UseAlpha" Grid.Column="1" Margin="0,0,12,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                        <Slider x:Name="SAlpha" Grid.Column="2" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                        <TextBlock Grid.Column="3" Text="{Binding Value, ElementName=SAlpha}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="颜色" Width="72" VerticalAlignment="Center" />
                        <StackPanel x:Name="ColorBox" Orientation="Horizontal" />
                    </StackPanel>
                    <StackPanel x:Name="RgbPanel" Margin="72,0,0,8">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <TextBlock Text="R" VerticalAlignment="Center" />
                            <Slider x:Name="SR" Grid.Column="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SR}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <TextBlock Text="G" VerticalAlignment="Center" />
                            <Slider x:Name="SG" Grid.Column="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SG}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <TextBlock Text="B" VerticalAlignment="Center" />
                            <Slider x:Name="SB" Grid.Column="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Any_Changed" />
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SB}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                    </StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="Dot" Content="中心点" Margin="0,0,16,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                        <CheckBox x:Name="TStyle" Content="T 字型" Margin="0,0,16,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                        <CheckBox x:Name="Recoil" Content="跟随后坐力" Margin="0,0,16,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                        <CheckBox x:Name="WeaponGap" Content="按武器调整间隙" Checked="Any_Changed" Unchecked="Any_Changed" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <TextBlock Text="控制台指令" Style="{StaticResource SectionTitle}" />
        <TextBox x:Name="Cmd" Style="{StaticResource Mono}" MinHeight="56" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="复制指令" Click="Copy_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="写入 autoexec.cfg" Appearance="Primary" Margin="8,0,0,0" Click="Write_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </StackPanel>
</Page>
