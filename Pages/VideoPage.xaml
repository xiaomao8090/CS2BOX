<Page x:Class="CS2Box.Pages.VideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="视频设置">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="视频设置" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Sub" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <TextBlock Text="显示" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ResizeLarge24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="分辨率" />
                    <TextBlock x:Name="AspectText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="Res" Width="180" IsEditable="True" SelectionChanged="Res_Changed" LostFocus="Res_LostFocus" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
            <ui:CardControl.Header><TextBlock Text="显示模式" /></ui:CardControl.Header>
            <ComboBox x:Name="Mode" Width="180">
                <ComboBoxItem Content="全屏" />
                <ComboBoxItem Content="无边框窗口" />
                <ComboBoxItem Content="窗口" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="TopSpeed24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="刷新率 (Hz)" />
                    <TextBlock Text="0 表示跟随桌面设置" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="Refresh" Width="180" IsEditable="True" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:CardControl.Icon>
            <ui:CardControl.Header><TextBlock Text="垂直同步" /></ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="Vsync" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Flash24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="NVIDIA Reflex 低延迟" />
                    <TextBlock Text="setting.r_low_latency" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="Latency" Width="180">
                <ComboBoxItem Content="关" />
                <ComboBoxItem Content="开" />
                <ComboBoxItem Content="开 + 加速" />
            </ComboBox>
        </ui:CardControl>

        <TextBlock Text="画质" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="多重采样抗锯齿 (MSAA)" /></ui:CardControl.Header>
            <ComboBox x:Name="Msaa" Width="180">
                <ComboBoxItem Content="无" Tag="0" />
                <ComboBoxItem Content="2x" Tag="2" />
                <ComboBoxItem Content="4x" Tag="4" />
                <ComboBoxItem Content="8x" Tag="8" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="阴影质量" /></ui:CardControl.Header>
            <ComboBox x:Name="Shadow" Width="180">
                <ComboBoxItem Content="低" />
                <ComboBoxItem Content="中" />
                <ComboBoxItem Content="高" />
                <ComboBoxItem Content="非常高" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="模型 / 贴图细节" /></ui:CardControl.Header>
            <ComboBox x:Name="Texture" Width="180">
                <ComboBoxItem Content="低" />
                <ComboBoxItem Content="中" />
                <ComboBoxItem Content="高" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="着色器细节" /></ui:CardControl.Header>
            <ComboBox x:Name="Shader" Width="180">
                <ComboBoxItem Content="低" />
                <ComboBoxItem Content="高" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="粒子细节" /></ui:CardControl.Header>
            <ComboBox x:Name="Particle" Width="180">
                <ComboBoxItem Content="低" />
                <ComboBoxItem Content="中" />
                <ComboBoxItem Content="高" />
                <ComboBoxItem Content="非常高" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="环境光遮蔽" /></ui:CardControl.Header>
            <ComboBox x:Name="Ao" Width="180">
                <ComboBoxItem Content="关" />
                <ComboBoxItem Content="中" />
                <ComboBoxItem Content="高" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header><TextBlock Text="FidelityFX 超级分辨率" /></ui:CardControl.Header>
            <ComboBox x:Name="Fsr" Width="180">
                <ComboBoxItem Content="关（最高画质）" />
                <ComboBoxItem Content="超高质量" />
                <ComboBoxItem Content="质量" />
                <ComboBoxItem Content="平衡" />
                <ComboBoxItem Content="性能" />
            </ComboBox>
        </ui:CardControl>

        <ui:InfoBar Margin="0,16,0,0" IsOpen="True" IsClosable="False" Severity="Informational"
                    Title="关于拉伸"
                    Message="4:3 拉伸需要在显卡控制面板里把缩放模式设为“全屏”，并让游戏使用全屏模式；只改这里的分辨率会是黑边。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="重新读取" Click="Reload_Click" />
            <ui:Button Content="打开文件" Margin="8,0,0,0" Click="Open_Click" />
            <ui:Button Content="保存" Appearance="Primary" MinWidth="96" Margin="8,0,0,0" Click="Save_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </StackPanel>
</Page>
