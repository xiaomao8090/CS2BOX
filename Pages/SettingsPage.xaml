<Page x:Class="CS2Box.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="设置">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />

        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="DarkTheme24" /></ui:CardControl.Icon>
            <ui:CardControl.Header><TextBlock Text="主题" /></ui:CardControl.Header>
            <ComboBox x:Name="Theme" Width="160" SelectionChanged="Theme_Changed">
                <ComboBoxItem Content="跟随系统" Tag="System" />
                <ComboBoxItem Content="浅色" Tag="Light" />
                <ComboBoxItem Content="深色" Tag="Dark" />
            </ComboBox>
        </ui:CardControl>

        <TextBlock Text="路径" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Steam" />
                    <TextBlock x:Name="SteamPath" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="自动检测" Margin="0,0,8,0" Click="AutoDetect_Click" />
                <ui:Button Content="选择…" Click="Browse_Click" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Games24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="CS2" />
                    <TextBlock x:Name="Cs2Path" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="打开" Click="OpenCs2_Click" />
        </ui:CardControl>

        <TextBlock Text="常规" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowMinimize24" /></ui:CardControl.Icon>
            <ui:CardControl.Header><TextBlock Text="启动游戏后最小化" /></ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="Minimize" Checked="Minimize_Changed" Unchecked="Minimize_Changed" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="关闭窗口时缩到托盘" />
                    <TextBlock Text="关掉后点 × 会直接退出" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="CloseToTray" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="启动 CS2 的全局快捷键" />
                    <TextBlock Text="盒子在后台或托盘里时也能用" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="Hotkey" Width="180" SelectionChanged="Hotkey_Changed" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Database24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="数据目录" />
                    <TextBlock x:Name="DataDir" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="打开" Click="OpenData_Click" />
        </ui:CardControl>

        <TextBlock Text="更新" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Link24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="更新地址" />
                    <TextBlock Text="指向 version.json 的 https 网址，留空则不检查" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="UpdateUrl" Width="300" LostFocus="UpdateUrl_LostFocus" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Info24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="CS2 盒子" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button x:Name="CheckBtn" Content="检查更新" Click="Check_Click" />
        </ui:CardControl>

        <TextBlock Text="协议" Style="{StaticResource SectionTitle}" />
        <ui:CardControl>
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="免责声明" />
                    <TextBlock Text="首次启动时同意过的那份，随时可以重新看" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="查看" Click="ShowEula_Click" />
        </ui:CardControl>
    </StackPanel>
</Page>
