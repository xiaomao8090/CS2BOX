<Page x:Class="CS2Box.Pages.PingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="服务器延迟">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="服务器延迟" Style="{StaticResource PageTitle}" />
        <TextBlock Text="测试到 Valve 各数据中心的延迟。部分节点不响应 ping，会显示超时，不代表进不去。" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="StartBtn" Content="开始测试" Appearance="Primary" Click="Start_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Pulse24" /></ui:Button.Icon>
            </ui:Button>
            <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,10" Margin="0,0,0,2" CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding MsText}" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
