<Page x:Class="CS2Box.Pages.RealNamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="国服认证">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,32" MaxWidth="820">
            <TextBlock Text="国服认证" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSub}"
                       Text="蒸汽平台（国服）的实名认证。把浏览器地址栏那条链接复制过来，剩下的按顺序填就行。" />

            <ui:Card Padding="24,20">
                <StackPanel>
                    <TextBlock x:Name="StepText" Margin="0,0,0,16" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- 第 1 步：链接 -->
                    <StackPanel x:Name="PanelLink">
                        <TextBlock Text="把链接粘进来" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="从 store.steamchina.com/agreements?token=… 整条复制，token 会自动挑出来。"
                                   FontSize="12" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="LinkBox" FontFamily="Consolas" Padding="10,8"
                                 AcceptsReturn="False" TextWrapping="NoWrap" />
                        <ui:Button x:Name="BtnLink" Content="下一步" Appearance="Primary"
                                   MinWidth="120" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Link_Click" />
                    </StackPanel>

                    <!-- 第 2 步：姓名 / 身份证 -->
                    <StackPanel x:Name="PanelId" Visibility="Collapsed">
                        <TextBlock Text="姓名和身份证" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="姓名" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="NameBox" Padding="10,8" />
                        <TextBlock Text="身份证号" FontSize="12" Margin="0,12,0,4"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="IdBox" FontFamily="Consolas" Padding="10,8"
                                 TextChanged="Id_TextChanged" />
                        <TextBlock x:Name="IdInfoText" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:Button x:Name="BtnId" Content="下一步" Appearance="Primary"
                                   MinWidth="120" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Id_Click" />
                    </StackPanel>

                    <!-- 第 3 步：手机号 -->
                    <StackPanel x:Name="PanelPhone" Visibility="Collapsed">
                        <TextBlock Text="手机号" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="收短信验证码用。滑块这边会自动过，不用管。"
                                   FontSize="12" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="PhoneBox" FontFamily="Consolas" Padding="10,8" MaxWidth="260"
                                 HorizontalAlignment="Left" />
                        <ui:Button x:Name="BtnPhone" Content="发送验证码" Appearance="Primary"
                                   MinWidth="120" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Phone_Click" />
                    </StackPanel>

                    <!-- 第 4 步：验证码 -->
                    <StackPanel x:Name="PanelCode" Visibility="Collapsed">
                        <TextBlock Text="短信验证码" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="CodeHint" Text="短信到了填这里，60 秒内有效。"
                                   FontSize="12" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="18" Padding="10,8"
                                 MaxLength="6" MaxWidth="180" HorizontalAlignment="Left" />
                        <ui:Button x:Name="BtnSubmit" Content="提交" Appearance="Primary"
                                   MinWidth="120" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Submit_Click" />
                    </StackPanel>

                    <TextBlock x:Name="Status" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </ui:Card>

            <TextBlock Margin="4,12,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="说明：一个链接只能用一次，做完换新号要重新去网页复制。一张身份证能绑的账号有限，绑满了会直接报错。" />
        </StackPanel>
    </ScrollViewer>
</Page>
