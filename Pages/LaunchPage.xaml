<Page x:Class="CS2Box.Pages.LaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="启动项">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="启动项" Style="{StaticResource PageTitle}" />
        <TextBlock Text="从盒子启动游戏时会带上这些参数。也可以写入 Steam 的启动选项，这样直接从 Steam 启动也生效。" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <StackPanel x:Name="Options" />

        <ui:CardControl Margin="0,4,0,0">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="TextEditStyle24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="额外参数" />
                    <TextBlock Text="例如 +exec autoexec.cfg -w 1280 -h 960" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="Extra" Width="280" TextChanged="Extra_TextChanged" />
        </ui:CardControl>

        <TextBlock Text="结果" Style="{StaticResource SectionTitle}" />
        <TextBox x:Name="Result" Style="{StaticResource Mono}" MinHeight="40" />
        <TextBlock x:Name="SteamCurrent" Margin="2,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="复制" Click="Copy_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="写入 Steam 启动选项" Margin="8,0,0,0" Click="WriteSteam_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="用这些参数启动" Appearance="Primary" Margin="8,0,0,0" Click="Launch_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </StackPanel>
</Page>
