<Page x:Class="CS2Box.Pages.WorkshopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="创意工坊">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="创意工坊" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Sub" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="管理订阅" Appearance="Primary" Click="Manage_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Open24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="刷新" Margin="8,0,0,0" Click="Refresh_Click" />
            <ui:Button Content="打开工坊目录" Margin="8,0,0,0" Click="OpenDir_Click" />
        </StackPanel>

        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                    Title="说明"
                    Message="取消订阅要在 Steam 里操作（点“管理订阅”）。只删本地文件的话，仍在订阅的物品下次会被 Steam 重新下载。" />

        <TextBlock x:Name="Empty" Text="没有已下载的工坊物品。" Margin="0,24" HorizontalAlignment="Center" Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,4">
                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="Map24" /></ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="工坊页面" Margin="0,0,8,0" Click="Page_Click" Tag="{Binding}" />
                            <ui:Button Content="删除本地文件" Click="Delete_Click" Tag="{Binding}" />
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
