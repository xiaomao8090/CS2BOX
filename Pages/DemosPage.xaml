<Page x:Class="CS2Box.Pages.DemosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="录像">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="录像" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Sub" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="刷新" Click="Refresh_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="打开录像目录" Margin="8,0,0,0" Click="OpenDir_Click" />
            <ui:Button Content="删除 30 天前的录像" Margin="8,0,0,0" Click="DeleteOld_Click" />
        </StackPanel>

        <TextBlock x:Name="Empty" Text="没有找到录像。" Margin="0,24" HorizontalAlignment="Center" Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,4">
                        <ui:CardControl.Icon><ui:SymbolIcon Symbol="Video24" /></ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="位置" Margin="0,0,8,0" Click="Reveal_Click" Tag="{Binding}" />
                            <ui:Button Content="删除" Margin="0,0,8,0" Click="Delete_Click" Tag="{Binding}" />
                            <ui:Button Content="播放" Appearance="Primary" MinWidth="72" Click="Play_Click" Tag="{Binding}" />
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
