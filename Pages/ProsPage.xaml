<Page x:Class="CS2Box.Pages.ProsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:CS2Box.Pages"
      Title="职业选手">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="职业选手" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Sub" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="Search" PlaceholderText="搜索选手或战队" TextChanged="Search_TextChanged">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="我的鼠标 DPI" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBox x:Name="MyDpi" Width="90" TextChanged="MyDpi_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button Content="编辑数据" Click="Edit_Click" />
                <ui:Button Content="恢复自带数据" Margin="8,0,0,0" Click="Reset_Click" />
            </StackPanel>
        </Grid>

        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,4" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="4" Background="#5F6B73">
                                <Grid>
                                    <local:CrosshairView Width="64" Height="64" Scale="2" Crosshair="{Binding Crosshair}" />
                                    <TextBlock Text="无准星" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCrosshair}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Team}" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="330" HorizontalAlignment="Right">
                                <ui:Button Content="用准星" Margin="0,2,6,2" Click="ApplyCrosshair_Click" Tag="{Binding}" IsEnabled="{Binding HasCrosshair}" />
                                <ui:Button Content="用灵敏度和视角" Margin="0,2,6,2" Click="ApplyMouse_Click" Tag="{Binding}" />
                                <ui:Button Content="用分辨率" Margin="0,2,6,2" Click="ApplyRes_Click" Tag="{Binding}" />
                                <ui:Button Content="填准星分享码" Margin="0,2,6,2" Click="SetCode_Click" Tag="{Binding}" />
                                <ui:Button Content="资料页" Margin="0,2,0,2" Appearance="Transparent" Click="Open_Click" Tag="{Binding}" />
                            </WrapPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
