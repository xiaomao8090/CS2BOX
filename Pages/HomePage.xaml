<Page x:Class="CS2Box.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="主页">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="主页" Style="{StaticResource PageTitle}" Margin="0,0,0,20" />

        <!-- 游戏 -->
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Games24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Counter-Strike 2" FontWeight="SemiBold" />
                    <TextBlock x:Name="GamePath" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button x:Name="LaunchBtn" Content="启动" Appearance="Primary" MinWidth="100" Click="Launch_Click" />
        </ui:CardControl>
        <TextBlock x:Name="ArgsLine" Margin="4,8,0,0" FontSize="12" FontFamily="Consolas"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <!-- 工具 -->
        <TextBlock Text="工具" Style="{StaticResource SectionTitle}" />
        <ui:CardAction Margin="0,0,0,4" Click="GoAccounts">
            <ui:CardAction.Icon><ui:SymbolIcon Symbol="PeopleSwap24" /></ui:CardAction.Icon>
            <StackPanel>
                <TextBlock Text="账号切换" />
                <TextBlock Text="切换本机登录过的 Steam 账号" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,4" Click="GoLaunch">
            <ui:CardAction.Icon><ui:SymbolIcon Symbol="Rocket24" /></ui:CardAction.Icon>
            <StackPanel>
                <TextBlock Text="启动项" />
                <TextBlock x:Name="LaunchDesc" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,4" Click="GoCrosshair">
            <ui:CardAction.Icon><ui:SymbolIcon Symbol="Target24" /></ui:CardAction.Icon>
            <TextBlock Text="准星" />
        </ui:CardAction>
        <ui:CardAction Margin="0,0,0,4" Click="GoConfig">
            <ui:CardAction.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:CardAction.Icon>
            <StackPanel>
                <TextBlock Text="配置文件" />
                <TextBlock Text="备份和还原按键、视频设置、autoexec.cfg" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:CardAction>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="着色器缓存" />
                    <TextBlock x:Name="CacheSize" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="清理" Click="ClearCache_Click" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ShieldCheckmark24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <TextBlock Text="游戏文件" />
            </ui:CardControl.Header>
            <ui:Button Content="验证完整性" Click="Validate_Click" />
        </ui:CardControl>

        <!-- 当前账号 -->
        <TextBlock Text="当前账号" Style="{StaticResource SectionTitle}" />
        <ui:Card Padding="20,12">
            <Grid x:Name="AccountGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="昵称" Opacity="0.7" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AccNick" Text="—" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="用户名" Opacity="0.7" />
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="AccUser" Text="—" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Steam64" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AccId" Text="—" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="上次登录" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="AccLast" Text="—" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="记住密码" Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AccRemember" Text="—" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="CS2 配置" Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="AccCfg" Text="—" />
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>
