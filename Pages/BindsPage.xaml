<Page x:Class="CS2Box.Pages.BindsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="按键绑定">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="按键绑定" Style="{StaticResource PageTitle}" />
        <TextBlock Text="给常用指令填一个按键（例如 n、mouse4、kp_end），留空就是不用。写入 autoexec.cfg 后生效。" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <StackPanel x:Name="List" />

        <TextBlock Text="将写入" Style="{StaticResource SectionTitle}" />
        <TextBox x:Name="Preview" Style="{StaticResource Mono}" MinHeight="40" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="复制" Click="Copy_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="写入 autoexec.cfg" Appearance="Primary" Margin="8,0,0,0" Click="Write_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </StackPanel>
</Page>
