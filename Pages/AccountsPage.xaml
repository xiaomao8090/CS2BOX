<Page x:Class="CS2Box.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="账号切换">
    <StackPanel Margin="40,28,40,32" MaxWidth="1000">
        <TextBlock Text="账号切换" Style="{StaticResource PageTitle}" />
        <TextBlock Text="列出本机 Steam 登录过的账号。只有登录时勾了“记住密码”的账号才能免密切换。" Style="{StaticResource PageSub}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox x:Name="Search" Width="280" PlaceholderText="搜索昵称或用户名" TextChanged="Search_TextChanged">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
            <ui:Button Content="刷新" Margin="8,0,0,0" Click="Refresh_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="登录新账号" Margin="8,0,0,0" Click="AddNew_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="PersonAdd24" /></ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <TextBlock x:Name="Empty" Visibility="Collapsed" Margin="0,24" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="没有找到账号。确认已安装 Steam 并至少登录过一次。" />

        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,4">
                        <ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40">
                                    <Ellipse Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Fill="{Binding AvatarBrush}" />
                                </Grid>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Account.PersonaName}" FontWeight="SemiBold" />
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{Binding CurrentVisibility}">
                                            <TextBlock Text="当前" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="打开配置" Margin="0,0,8,0" Click="OpenCfg_Click" Tag="{Binding Account}" />
                            <ui:Button Content="{Binding ActionText}" Appearance="{Binding ActionAppearance}"
                                       IsEnabled="{Binding CanSwitch}" MinWidth="80" Click="Switch_Click" Tag="{Binding Account}" />
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
